# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in EVERY value.
# Never commit .env.prod. Generate secrets with:  openssl rand -base64 48
# Full explanation of each variable: docs/DEPLOY.md

# --- Domain / HTTPS (Caddy gets a Let's Encrypt certificate automatically) ---
SITE_ADDRESS=rca.example.com
ACME_EMAIL=you@example.com
APP_URL=https://rca.example.com

# --- Database (the db service is only reachable inside the compose network) ---
POSTGRES_USER=rca
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=rca
DATABASE_POOL_SIZE=10

# --- Auth ---
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# --- Email: smtp or resend (console is refused in production) ---
EMAIL_PROVIDER=resend
EMAIL_FROM=RCA Dashboard <no-reply@rca.example.com>
RESEND_API_KEY=
# For SMTP instead:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Object storage for attachments (AWS S3, Cloudflare R2, Backblaze B2, MinIO) ---
STORAGE_DRIVER=s3
S3_BUCKET=rca-attachments
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com   B2: https://s3.<region>.backblazeb2.com   AWS: leave empty
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Limits ---
MAX_UPLOAD_MB=10
QUOTA_STORAGE_MB=200
QUOTA_RCA_COUNT=500
LOGIN_MAX_PER_IP=30
LOGIN_MAX_PER_ACCOUNT=10
SIGNUP_MAX_PER_IP=10
EMAIL_MAX_PER_IP=10
EMAIL_MAX_PER_ACCOUNT=3
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15

# --- CAPTCHA (optional, Cloudflare Turnstile) ---
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- PDF rendering ---
PDF_TIMEOUT_MS=20000
PDF_CONCURRENCY=2
PDF_CHROMIUM_SANDBOX=true

# --- Account lifecycle ---
ACCOUNT_DELETION_GRACE_DAYS=14
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=60

# --- Google sign-in (optional; both or neither) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (docs/STRIPE_SETUP.md) ---
# Production refuses PAYMENT_PROVIDER=mock. On a staging server you may set
# PAYMENT_PROVIDER=mock, ALLOW_MOCK_PAYMENTS=true and a random MOCK_WEBHOOK_SECRET.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RCA_UNLOCK=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_SEAT=
# Displayed prices; keep them equal to the Stripe prices.
BILLING_CURRENCY=USD
RCA_UNLOCK_PRICE_CENTS=900
SOLO_MONTHLY_PRICE_CENTS=1200
TEAM_BASE_PRICE_CENTS=2900
TEAM_SEAT_PRICE_CENTS=800

# --- Backups (backup service) ---
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION_DAYS=14
# Optional off-site copy to an S3-compatible bucket:
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info
