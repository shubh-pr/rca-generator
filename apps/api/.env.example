DATABASE_URL=postgresql://rca:rca@localhost:5433/rca
TEST_DATABASE_URL=postgresql://rca:rca@localhost:5433/rca_test
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
PORT=4000
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Demo data (only honoured together with NODE_ENV=development)
SEED_DEMO=true
# --- Auth (see docs/DEPLOY.md for the full list) ---
APP_URL=http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# EMAIL_PROVIDER: console (dev only) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=RCA Dashboard <no-reply@localhost>
MAIL_LOG_FILE=
TURNSTILE_ENABLED=false

# --- Billing (docs/BILLING_PLAN.md, docs/STRIPE_SETUP.md) ---
# mock: no external calls, TEST MODE checkout. stripe: needs every STRIPE_* value below.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-for-tests
BILLING_CURRENCY=USD
RCA_UNLOCK_PRICE_CENTS=900
SOLO_MONTHLY_PRICE_CENTS=1200
TEAM_BASE_PRICE_CENTS=2900
TEAM_SEAT_PRICE_CENTS=800
QUOTA_OWNED_WORKSPACES=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RCA_UNLOCK=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_SEAT=

# --- Sign in with Google / Microsoft (optional; docs/OAUTH_SETUP.md). Each provider: both values or neither ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Defaults to APP_URL; register <this>/api/v1/auth/google/callback and .../microsoft/callback with the providers.
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
