// RCA Admin Dashboard data model. Mirrors Section 4 of docs/SPEC.md.
// Table and column names are the spec's snake_case names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 4.1 Enumerations ----------

enum Severity {
  P1
  P2
  P3
  P4

  @@map("severity")
}

enum Environment {
  PROD
  UAT
  STAGING

  @@map("environment")
}

enum RcaStatus {
  DRAFT
  IN_REVIEW
  CLOSED

  @@map("rca_status")
}

enum Team {
  DEV
  QA
  PROD

  @@map("team")
}

enum SectionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED

  @@map("section_status")
}

enum CauseCategory {
  CODE_DEFECT
  CONFIG
  REQUIREMENT_GAP
  TEST_GAP
  DEPLOYMENT
  INFRA
  THIRD_PARTY
  DATA

  @@map("cause_category")
}

enum ActionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("action_status")
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("completion_status")
}

enum DetectionMethod {
  MONITORING
  CLIENT_REPORT
  QA
  OTHER

  @@map("detection_method")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  CONTRIBUTOR
  VIEWER

  @@map("workspace_role")
}

enum SignoffRole {
  PROJECT_OWNER
  RCA_LEAD
  DEV_LEAD
  QA_LEAD
  PROD_LEAD

  @@map("signoff_role")
}

enum BillingPlan {
  NONE
  SOLO
  TEAM

  @@map("billing_plan")
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED

  @@map("subscription_status")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL

  @@map("email_token_type")
}

// ---------- Identity and tenancy (docs/B2C_PLAN.md section 3) ----------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(120)
  email              String    @unique @db.VarChar(180)
  password_hash      String?   @db.VarChar(200)
  email_verified_at  DateTime? @db.Timestamptz(3)
  last_login_at      DateTime? @db.Timestamptz(3)
  deleted_at         DateTime? @db.Timestamptz(3)
  purge_after        DateTime? @db.Timestamptz(3)
  is_platform_admin  Boolean   @default(false)
  is_active          Boolean   @default(true)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz(3)
  onboarded_at       DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)

  owned_workspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  collaborations    RcaCollaborator[]
  created_rcas      Rca[]             @relation("RcaCreatedBy")
  updated_rcas      Rca[]             @relation("RcaUpdatedBy")
  updated_sections  RcaTeamSection[]  @relation("SectionUpdatedBy")
  owned_actions     RcaAction[]       @relation("ActionOwner")
  created_actions   RcaAction[]       @relation("ActionCreatedBy")
  owned_followups   RcaFollowup[]     @relation("FollowupOwner")
  created_followups RcaFollowup[]     @relation("FollowupCreatedBy")
  created_timeline  RcaTimeline[]     @relation("TimelineCreatedBy")
  uploads           RcaAttachment[]
  signoffs          RcaSignoff[]      @relation("SignoffSignedBy")
  assigned_signoffs RcaSignoff[]      @relation("SignoffAssignee")
  audit_entries     AuditLog[]
  invitations_sent  Invitation[]      @relation("InvitedBy")
  email_tokens      EmailToken[]
  refresh_tokens    RefreshToken[]
  identities        UserIdentity[]
  quota             UsageQuota?
  support_grants    SupportGrant[]
  checkouts         CheckoutSession[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  /// Primary owner: the user whose quota this workspace uses.
  owner_id    String   @db.Uuid
  is_personal Boolean  @default(false)
  /// Billing (docs/BILLING_PLAN.md). Changed only by verified provider events.
  plan                 BillingPlan        @default(NONE)
  subscription_status  SubscriptionStatus @default(NONE)
  payment_customer_ref String?            @db.VarChar(120)
  subscription_ref     String?            @db.VarChar(120)
  current_period_end   DateTime?          @db.Timestamptz(3)
  /// Collaborator seats bought with a Team subscription.
  seats                Int                @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  owner          User              @relation("WorkspaceOwner", fields: [owner_id], references: [id])
  checkouts      CheckoutSession[]
  billing_events BillingEvent[]
  billing_history BillingHistory[]
  members        WorkspaceMember[]
  rcas           Rca[]
  invitations    Invitation[]
  support_grants SupportGrant[]
  audit_entries  AuditLog[]

  @@index([owner_id])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(uuid()) @db.Uuid
  workspace_id String        @db.Uuid
  user_id      String        @db.Uuid
  role         WorkspaceRole
  /// Team for a workspace-level CONTRIBUTOR (applies to every RCA in the workspace).
  team         Team?
  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  updated_at   DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([user_id])
  @@map("workspace_members")
}

model RcaCollaborator {
  id         String        @id @default(uuid()) @db.Uuid
  rca_id     String        @db.Uuid
  user_id    String        @db.Uuid
  role       WorkspaceRole
  team       Team?
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  updated_at DateTime      @updatedAt @db.Timestamptz(3)

  rca  Rca  @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([rca_id, user_id])
  @@index([user_id])
  @@map("rca_collaborators")
}

model Invitation {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @db.VarChar(180)
  workspace_id String?       @db.Uuid
  rca_id       String?       @db.Uuid
  role         WorkspaceRole
  team         Team?
  token_hash   String        @unique @db.VarChar(64)
  invited_by   String?       @db.Uuid
  expires_at   DateTime      @db.Timestamptz(3)
  accepted_at  DateTime?     @db.Timestamptz(3)
  accepted_by  String?       @db.Uuid
  revoked_at   DateTime?     @db.Timestamptz(3)
  created_at   DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rca       Rca?       @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  inviter   User?      @relation("InvitedBy", fields: [invited_by], references: [id], onDelete: SetNull)

  @@index([email, accepted_at, revoked_at])
  @@index([workspace_id])
  @@index([rca_id])
  @@map("invitations")
}

model EmailToken {
  id         String         @id @default(uuid()) @db.Uuid
  user_id    String         @db.Uuid
  type       EmailTokenType
  token_hash String         @unique @db.VarChar(64)
  new_email  String?        @db.VarChar(180)
  expires_at DateTime       @db.Timestamptz(3)
  used_at    DateTime?      @db.Timestamptz(3)
  created_at DateTime       @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
  @@index([expires_at])
  @@map("email_tokens")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  /// One login session; all rotations of a token share the family.
  family_id      String    @db.Uuid
  token_hash     String    @unique @db.VarChar(64)
  expires_at     DateTime  @db.Timestamptz(3)
  revoked_at     DateTime? @db.Timestamptz(3)
  replaced_by_id String?   @db.Uuid
  user_agent     String?   @db.VarChar(255)
  created_at     DateTime  @default(now()) @db.Timestamptz(3)
  last_used_at   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

/// Per-user limits (null = env default; extension point for billing) and a usage snapshot.
model UsageQuota {
  user_id             String   @id @db.Uuid
  storage_limit_bytes BigInt?
  rca_limit           Int?
  storage_bytes_used  BigInt   @default(0)
  rca_count           Int      @default(0)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("usage_quotas")
}

/// Audited, time-limited read-only access for a platform admin (support and abuse handling).
model SupportGrant {
  id            String   @id @default(uuid()) @db.Uuid
  admin_user_id String   @db.Uuid
  workspace_id  String   @db.Uuid
  reason        String
  expires_at    DateTime @db.Timestamptz(3)
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  admin     User      @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([admin_user_id, expires_at])
  @@index([workspace_id])
  @@map("support_grants")
}

// ---------- 4.4 rca ----------

model Rca {
  id                  String           @id @default(uuid()) @db.Uuid
  workspace_id        String           @db.Uuid
  rca_number          String           @db.VarChar(20)
  rca_date            DateTime         @db.Date
  company_name        String?          @db.VarChar(150)
  project_name        String?          @db.VarChar(150)
  project_owner_name  String?          @db.VarChar(120)
  team_leader_name    String?          @db.VarChar(120)
  ticket_id           String?          @db.VarChar(60)
  severity            Severity
  environment         Environment
  status              RcaStatus        @default(DRAFT)
  version             Int              @default(1)
  incident_start      DateTime         @db.Timestamptz(3)
  detected_at         DateTime?        @db.Timestamptz(3)
  resolved_at         DateTime?        @db.Timestamptz(3)
  prepared_by_name    String?          @db.VarChar(120)
  reviewed_by_name    String?          @db.VarChar(120)
  summary             String
  impact_users        String?
  impact_duration     String?          @db.VarChar(80)
  impact_data_revenue String?
  sla_breached        Boolean          @default(false)
  detection_method    DetectionMethod?
  immediate_fix       String?
  immediate_fix_by    String?          @db.VarChar(120)
  lessons_well        String?
  lessons_not_well    String?
  lessons_key         String?
  is_sample           Boolean          @default(false)
  /// Set once by a verified RCA_UNLOCK payment; never cleared.
  paid_at             DateTime?        @db.Timestamptz(3)
  payment_reference   String?          @db.VarChar(120)
  is_deleted          Boolean          @default(false)
  closed_at           DateTime?        @db.Timestamptz(3)
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  updated_at          DateTime         @updatedAt @db.Timestamptz(3)
  created_by          String?          @db.Uuid
  updated_by          String?          @db.Uuid

  workspace       Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  created_by_user User?             @relation("RcaCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updated_by_user User?             @relation("RcaUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  timeline        RcaTimeline[]
  sections        RcaTeamSection[]
  followups       RcaFollowup[]
  attachments     RcaAttachment[]
  signoffs        RcaSignoff[]
  collaborators   RcaCollaborator[]
  invitations     Invitation[]
  audit_entries   AuditLog[]
  checkouts       CheckoutSession[]
  billing_history BillingHistory[]

  @@unique([workspace_id, rca_number])
  @@index([workspace_id, is_deleted, rca_date])
  @@index([workspace_id, status])
  @@index([status])
  @@index([rca_date])
  @@index([severity])
  @@map("rca")
}

// Per-workspace yearly counter for RCA-YYYY-NNNN, incremented inside the RCA insert transaction.
model RcaNumberSeq {
  workspace_id String @db.Uuid
  year         Int
  last_value   Int

  @@id([workspace_id, year])
  @@map("rca_number_seq")
}

// ---------- 4.5 rca_timeline ----------

model RcaTimeline {
  id             String   @id @default(uuid()) @db.Uuid
  rca_id         String   @db.Uuid
  event_time     DateTime @db.Timestamptz(3)
  event          String
  team_or_person String?  @db.VarChar(120)
  sort_order     Int?
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)
  created_by     String?  @db.Uuid

  rca             Rca   @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  created_by_user User? @relation("TimelineCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([rca_id])
  @@map("rca_timeline")
}

// ---------- 4.6 rca_team_section ----------

model RcaTeamSection {
  id                String           @id @default(uuid()) @db.Uuid
  rca_id            String           @db.Uuid
  team              Team
  contributor_name  String?          @db.VarChar(120)
  cause_category    CauseCategory?
  escape_analysis   String?
  extra_1           String?
  extra_2           String?
  prev_process      String?
  prev_automation   String?
  prev_owner_date   String?          @db.VarChar(160)
  target_date       DateTime?        @db.Date
  actual_date       DateTime?        @db.Date
  completion_status CompletionStatus @default(NOT_STARTED)
  verified_by_name  String?          @db.VarChar(120)
  section_status    SectionStatus    @default(NOT_STARTED)
  submitted_at      DateTime?        @db.Timestamptz(3)
  version           Int              @default(1)
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @updatedAt @db.Timestamptz(3)
  updated_by        String?          @db.Uuid

  rca              Rca         @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  updated_by_user  User?       @relation("SectionUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  whys             RcaWhy[]
  actions          RcaAction[]

  @@unique([rca_id, team])
  @@map("rca_team_section")
}

// ---------- 4.7 rca_why, rca_action, rca_followup ----------

model RcaWhy {
  id         String  @id @default(uuid()) @db.Uuid
  section_id String  @db.Uuid
  why_no     Int     @db.SmallInt
  answer     String?

  section RcaTeamSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, why_no])
  @@map("rca_why")
}

model RcaAction {
  id           String       @id @default(uuid()) @db.Uuid
  section_id   String       @db.Uuid
  seq          Int?
  action       String
  owner_id     String       @db.Uuid
  due_date     DateTime     @db.Date
  status       ActionStatus @default(NOT_STARTED)
  completed_on DateTime?    @db.Date
  created_at   DateTime     @default(now()) @db.Timestamptz(3)
  updated_at   DateTime     @updatedAt @db.Timestamptz(3)
  created_by   String?      @db.Uuid

  section         RcaTeamSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  owner           User           @relation("ActionOwner", fields: [owner_id], references: [id])
  created_by_user User?          @relation("ActionCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  followup        RcaFollowup?

  @@index([owner_id, status, due_date])
  @@index([section_id])
  @@map("rca_action")
}

model RcaFollowup {
  id         String    @id @default(uuid()) @db.Uuid
  rca_id     String    @db.Uuid
  risk       String
  owner_id   String?   @db.Uuid
  due_date   DateTime? @db.Date
  // Set when an open action was moved to follow-ups (see docs/ASSUMPTIONS.md).
  action_id  String?   @unique @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  updated_at DateTime  @updatedAt @db.Timestamptz(3)
  created_by String?   @db.Uuid

  rca             Rca        @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  owner           User?      @relation("FollowupOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  created_by_user User?      @relation("FollowupCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  action          RcaAction? @relation(fields: [action_id], references: [id], onDelete: SetNull)

  @@index([rca_id])
  @@map("rca_followup")
}

// ---------- 4.8 rca_attachment, rca_signoff, audit_log ----------

model RcaAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  rca_id      String   @db.Uuid
  description String?  @db.VarChar(255)
  kind        String   @db.VarChar(10)
  file_path   String?
  url         String?
  file_name   String?  @db.VarChar(255)
  mime        String?  @db.VarChar(120)
  size        Int?
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  rca      Rca   @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([rca_id])
  @@index([uploaded_by])
  @@map("rca_attachment")
}

model RcaSignoff {
  id         String      @id @default(uuid()) @db.Uuid
  rca_id     String      @db.Uuid
  role             SignoffRole
  /// Person asked to sign this row (null: any OWNER/EDITOR of the RCA may sign).
  assignee_user_id String?     @db.Uuid
  /// Person who signed.
  user_id          String?     @db.Uuid
  signed_at        DateTime?   @db.Timestamptz(3)
  comment    String?
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @updatedAt @db.Timestamptz(3)

  rca      Rca   @relation(fields: [rca_id], references: [id], onDelete: Cascade)
  user     User? @relation("SignoffSignedBy", fields: [user_id], references: [id], onDelete: SetNull)
  assignee User? @relation("SignoffAssignee", fields: [assignee_user_id], references: [id], onDelete: SetNull)

  @@unique([rca_id, role])
  @@index([assignee_user_id])
  @@map("rca_signoff")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  entity    String   @db.VarChar(40)
  entity_id String   @db.Uuid
  // Owning RCA, so the audit screen can filter child-entity events by RCA.
  rca_id       String?  @db.Uuid
  workspace_id String?  @db.Uuid
  /// DATA (RCA changes) or SECURITY (login, password, email, invitation, export, delete).
  category     String   @default("DATA") @db.VarChar(10)
  action       String   @db.VarChar(30)
  old_value Json?
  new_value Json?
  user_id   String?  @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz(3)

  rca       Rca?       @relation(fields: [rca_id], references: [id])
  workspace Workspace? @relation(fields: [workspace_id], references: [id])
  user      User?      @relation(fields: [user_id], references: [id])

  @@index([workspace_id, at])
  @@index([category, user_id, at])
  @@index([user_id])
  @@index([rca_id, at])
  @@index([user_id, at])
  @@index([at])
  @@map("audit_log")
}

// ---------- Billing (docs/BILLING_PLAN.md) ----------

/** A checkout we started with the payment provider; events are cross-checked against it. */
model CheckoutSession {
  id                  String       @id @default(uuid()) @db.Uuid
  provider            String       @db.VarChar(20)
  provider_session_id String?      @db.VarChar(200)
  /// RCA_UNLOCK or SUBSCRIPTION
  kind                String       @db.VarChar(20)
  workspace_id        String       @db.Uuid
  rca_id              String?      @db.Uuid
  plan                BillingPlan?
  seats               Int?
  amount_cents        Int
  currency            String       @db.VarChar(3)
  /// OPEN, COMPLETED, FAILED, CANCELED
  status              String       @default("OPEN") @db.VarChar(12)
  created_by          String?      @db.Uuid
  created_at          DateTime     @default(now()) @db.Timestamptz(3)
  completed_at        DateTime?    @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rca       Rca?      @relation(fields: [rca_id], references: [id], onDelete: SetNull)
  creator   User?     @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([provider, provider_session_id])
  @@map("checkout_sessions")
}

/** Append-only log of every provider event; UNIQUE(provider, provider_event_id) makes replays no-ops. */
model BillingEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @db.VarChar(20)
  provider_event_id String    @db.VarChar(200)
  type              String    @db.VarChar(40)
  payload           Json
  workspace_id      String?   @db.Uuid
  received_at       DateTime  @default(now()) @db.Timestamptz(3)
  processed_at      DateTime? @db.Timestamptz(3)
  result            String?   @db.VarChar(200)

  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  @@unique([provider, provider_event_id])
  @@index([workspace_id, received_at])
  @@map("billing_events")
}

/** Payment and invoice lines shown in Account settings > Billing. */
model BillingHistory {
  id           String   @id @default(uuid()) @db.Uuid
  workspace_id String   @db.Uuid
  rca_id       String?  @db.Uuid
  /// RCA_UNLOCK or SUBSCRIPTION
  kind         String   @db.VarChar(20)
  description  String   @db.VarChar(200)
  amount_cents Int
  currency     String   @db.VarChar(3)
  /// PAID or FAILED
  status       String   @db.VarChar(10)
  reference    String?  @db.VarChar(200)
  occurred_at  DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rca       Rca?      @relation(fields: [rca_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, occurred_at])
  @@map("billing_history")
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT

  @@map("identity_provider")
}

/** A sign-in provider account (OpenID Connect `sub`) linked to a user. A user can have a password and several providers. */
model UserIdentity {
  id                  String           @id @default(uuid()) @db.Uuid
  user_id             String           @db.Uuid
  provider            IdentityProvider
  provider_account_id String           @db.VarChar(255)
  /** Email the provider reported when linking (display only; sign-in matches provider_account_id). */
  email               String?          @db.VarChar(180)
  linked_at           DateTime         @default(now()) @db.Timestamptz(3)
  last_used_at        DateTime?        @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@map("user_identities")
}

